-- RIDDLE PROCESSING - uses offline AI solver
local function processRiddle(msg)
    if not riddleMode or not msg or msg == "" then return end

    local lower = msg:lower()
    local isRiddle = false
    local riddleText = msg

    -- Detect Sammy announcements / riddles
    if lower:find("sammy says") then
        riddleText = msg:gsub("[Ss]ammy [Ss]ays:?%s*", "")
        isRiddle = true
    elseif lower:find("sammy:") then
        riddleText = msg:gsub("[Ss]ammy:?%s*", "")
        isRiddle = true
    elseif lower:find("sammy") and lower:find("riddle") then
        isRiddle = true
        riddleText = msg:gsub("[Ss]ammy", ""):gsub("[Rr]iddle", ""):gsub("^%s*", ""):gsub("%s*$", "")
    elseif msg:find("%s") then
        -- Any multi-word announcement can be a riddle when riddle mode is on
        isRiddle = true
        riddleText = msg
    end

    if not isRiddle or not riddleText or riddleText == "" then return end

    riddleText = riddleText:gsub("^%s*", ""):gsub("%s*$", "")

    -- If the message itself is already a plain code, redeem it
    if riddleText:match("^[A-Za-z0-9]+$") and #riddleText >= 4 then
        riddleBox.Text = "✅ Riddle Code: " .. riddleText
        riddleBox.TextColor3 = Color3.fromRGB(100, 255, 100)
        print("[MJ CODE SNIPER] Sammy said code: " .. riddleText)
        if scanning then
            typeAndSubmitCode(riddleText)
            print("[MJ CODE SNIPER] Redeemed riddle code: " .. riddleText)
        end
        riddleBuffer[#riddleBuffer + 1] = riddleText
        if #riddleBuffer > 5 then table.remove(riddleBuffer, 1) end
        task.delay(3, function()
            riddleBox.Text = ""
            riddleBox.TextColor3 = Color3.fromRGB(255, 220, 100)
        end)
        return
    end

    -- Try offline AI solve
    riddleBox.Text = "🤔 Solving: " .. riddleText
    riddleBox.TextColor3 = Color3.fromRGB(255, 220, 100)
    print("[MJ CODE SNIPER] Riddle: " .. riddleText)

    local answer, suffix = solveOfflineRiddle(riddleText)
    local top = tostring(answer or ""):gsub("%s+", "")
    if top ~= "" and suffix and tostring(suffix) ~= "" then
        top = top .. tostring(suffix)
    end
    top = top:upper()

    if top ~= "" then
        riddleBox.Text = "✅ Answer: " .. top
        riddleBox.TextColor3 = Color3.fromRGB(100, 255, 100)
        print("[MJ CODE SNIPER] Solved: " .. top)
        previewBox.Text = top
        if scanning then
            typeAndSubmitCode(top)
            print("[MJ CODE SNIPER] Redeemed riddle answer: " .. top)
        end
        riddleBuffer[#riddleBuffer + 1] = top
        if #riddleBuffer > 5 then table.remove(riddleBuffer, 1) end
        task.delay(5, function()
            if riddleBox.Text == "✅ Answer: " .. top then
                riddleBox.Text = ""
                riddleBox.TextColor3 = Color3.fromRGB(255, 220, 100)
            end
        end)
    else
        riddleBox.Text = "❓ No answer: " .. riddleText
        riddleBox.TextColor3 = Color3.fromRGB(255, 150, 80)
        print("[MJ CODE SNIPER] No answer found for: " .. riddleText)
        riddleBuffer[#riddleBuffer + 1] = riddleText
        if #riddleBuffer > 5 then table.remove(riddleBuffer, 1) end
        task.delay(8, function()
            if riddleBox.Text:find(riddleText, 1, true) then
                riddleBox.Text = ""
                riddleBox.TextColor3 = Color3.fromRGB(255, 220, 100)
            end
        end)
    end
end

local function onAnnouncement(txt)
    if not txt or txt == "" then return end

    if riddleMode then
        processRiddle(txt)
    end

    if not scanning then return end
    local msg = txt:match("^%s*(.-)%s*$")
    if msg and #msg > 0 and isValidCode(msg) then
        table.insert(buffer, msg)
        updatePreview()
        if #buffer >= mode then
            task.spawn(processBuffer)
        end
        print("[MJ CODE SNIPER] Captured: " .. msg .. " (buffer: " .. #buffer .. ")")
    end
end

local function toggleScan()
    scanning = not scanning
    if scanning then
        scanButton.Text = "SCANNING..."
        scanButton.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
        statusDot.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
        buffer = {}
        updatePreview()
        print("[MJ CODE SNIPER] Scanning started.")
    else
        scanButton.Text = "START SCAN"
        scanButton.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
        statusDot.BackgroundColor3 = Color3.fromRGB(220, 40, 50)
        buffer = {}
        updatePreview()
        print("[MJ CODE SNIPER] Scanning stopped.")
    end
end

scanButton.MouseButton1Click:Connect(toggleScan)

-- RIDDLE MODE TOGGLE
