local function applyBackground(index)
    local entry = BACKGROUND_PHOTOS[index]
    if not entry then return end
    bgIndex = index
    backgroundImage.BackgroundColor3 = entry.tint or Color3.fromRGB(20, 20, 25)
    backgroundImage.BackgroundTransparency = 0
    local img = ""
    if entry.embedKey then
        img = loadEmbedPhoto(entry.embedKey, entry.fileName or ("MJ_CS_" .. entry.embedKey .. ".jpg")) or ""
    end
    if (not img or img == "") and entry.id and entry.id ~= "" and entry.id ~= "rbxassetid://0" then
        img = entry.id
    end
    if img and img ~= "" then
        backgroundImage.Image = img
        backgroundImage.ImageTransparency = 0
    else
        backgroundImage.Image = ""
        backgroundImage.ImageTransparency = 1
    end
    overlay.BackgroundTransparency = entry.overlayTransparency or 0.45
    print("[MJ CODE SNIPER] Background ->", entry.name, img ~= "" and "OK" or "theme only")
end

