local function _b64decode(data)
	if not data or data == "" then return nil end
	if crypt and crypt.base64decode then
		local ok, r = pcall(function() return crypt.base64decode(tostring(data)) end)
		if ok and r and #tostring(r) > 10 then return r end
	end
	local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	data = tostring(data):gsub("[^A-Za-z0-9+/=]", "")
	local t = {}
	for i = 1, #b do t[b:sub(i, i)] = i - 1 end
	local out = {}
	local i = 1
	local n = #data
	while i <= n do
		local c1 = t[data:sub(i, i)] or 0; i = i + 1
		local c2 = t[data:sub(i, i)] or 0; i = i + 1
		local c3 = t[data:sub(i, i)]; i = i + 1
		local c4 = t[data:sub(i, i)]; i = i + 1
		local n2 = c1 * 262144 + c2 * 4096 + (c3 or 0) * 64 + (c4 or 0)
		out[#out + 1] = string.char(math.floor(n2 / 65536) % 256)
		if c3 then out[#out + 1] = string.char(math.floor(n2 / 256) % 256) end
		if c4 then out[#out + 1] = string.char(n2 % 256) end
	end
	return table.concat(out)
end

local EMBED_PHOTOS = {
	Chrome = [[]],
	RedMJ = [[]],
	GoldMJ = [[]],
	MJGlove = [[]],
}

local function loadEmbedPhoto(key, fname)
	local b64 = EMBED_PHOTOS[key]
	if not b64 or #b64 < 50 then return nil end
	if not writefile or not getcustomasset then return nil end
	local ok, data = pcall(_b64decode, b64)
	if not ok or not data then return nil end
	pcall(function()
		if not (isfile and isfile(fname)) then writefile(fname, data) end
	end)
	local ok2, asset = pcall(function() return getcustomasset(fname) end)
	if ok2 and asset and asset ~= "" then return asset end
	return nil
end
      
    
