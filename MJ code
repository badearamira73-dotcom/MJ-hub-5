    riddleMode = not riddleMode
    if riddleMode then
        riddleButton.Text = "RIDDLE ON"
        riddleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
        riddleBox.PlaceholderText = "Listening for Sammy / AI solving..."
        riddleBox.TextColor3 = Color3.fromRGB(100, 255, 100)
        print("[MJ CODE SNIPER] Riddle mode ON - offline AI solver active.")
    else
        riddleButton.Text = "RIDDLE"
        riddleButton.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
        riddleBox.PlaceholderText = "Riddle will appear here..."
        riddleBox.TextColor3 = Color3.fromRGB(255, 220, 100)
        riddleBox.Text = ""
        riddleBuffer = {}
        print("[MJ CODE SNIPER] Riddle mode deactivated.")
    end
end

riddleButton.MouseButton1Click:Connect(toggleRiddle)

modeButton.MouseButton1Click:Connect(function()
    mode = (mode % 4) + 1
    modeButton.Text = "MODE: " .. mode .. " GLOBAL MESSAGE" .. (mode > 1 and "S" or "")
    updatePreview()
    if scanning and #buffer >= mode then
        task.spawn(processBuffer)
    end
end)

local function manualRedeem()
    local code = previewBox.Text
    if code and code ~= "" then
        typeAndSubmitCode(code)
        print("[MJ CODE SNIPER] Manually redeemed: " .. code)
        buffer = {}
        updatePreview()
    end
end

redeemButton.MouseButton1Click:Connect(manualRedeem)

previewBox.FocusLost:Connect(function(enter)
    if enter then manualRedeem() end
end)

if notifyRemote then
    notifyRemote.OnClientEvent:Connect(function(txt, ...)
        onAnnouncement(txt)
    end)
else
    warn("[MJ CODE SNIPER] No notify remote - announcements not captured.")
end

