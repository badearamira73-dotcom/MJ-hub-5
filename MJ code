local function validPhoto(entry)
    if not entry then return false end
    if entry.embedKey and EMBED_PHOTOS and EMBED_PHOTOS[entry.embedKey] then return true end
    local id = entry.id or ""
    return id ~= "" and id ~= "rbxassetid://0" and id ~= "rbxassetid://"
