function M.ensureIdleSlots(idleFolder, n) if not idleFolder then return end n = n or 2 for i=1,n do M.ensureAnim(idleFolder, "Animation" .. i) end end  
function M.pick(pack, ...) for i = 1, select("#", ...) do local k = select(i, ...) local v = pack[k] if v ~= nil then return v end end return nil end  
