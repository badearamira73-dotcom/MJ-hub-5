-- Ping indicator for duels (no kick)
M.pingDuelEnabled = true
function M.getPingMs()
	local ping = 0
	pcall(function()
		local stats = game:GetService("Stats")
		local item = stats.Network.ServerStatsItem["Data Ping"]
		if item then
			local v = item:GetValue()
			if type(v) == "number" then ping = v
			elseif type(v) == "string" then ping = tonumber((v:gsub("ms",""):match("[%d%.]+"))) or 0
			end
		end
	end)
	if ping <= 0 then
		pcall(function()
			ping = math.floor((player:GetNetworkPing() or 0) * 1000 + 0.5)
		end)
	end
	return math.floor(ping + 0.5)
end
function M.getPingDuelStatus(ms)
	ms = tonumber(ms) or 0
	if ms <= 0 then return "checking...", Color3.fromRGB(180, 180, 180)
	elseif ms < 70 then return "DUEL BRO — GOOD", Color3.fromRGB(80, 255, 120)
	elseif ms < 110 then return "DUEL OK", Color3.fromRGB(255, 220, 80)
	else return "DON'T DUEL", Color3.fromRGB(255, 80, 80)
	end
end
