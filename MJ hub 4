function M.cacheIntroSong(option)
	if not option then return nil end
	local fileName = option.file or ("EmpireIntro_" .. tostring(option.name) .. ".mp3")

	if M.introSongCache[fileName] then
		return M.introSongCache[fileName]
	end

	-- Helper: try getcustomasset on a path
	local function tryAsset(path)
		if not getcustomasset then return nil end
		local ok, asset = pcall(function() return getcustomasset(path) end)
		if ok and asset and asset ~= "" and asset ~= "rbxassetid://0" then
			return asset
		end
		return nil
	end

	-- Helper: check if file exists
	local function fileExists(path)
		local ok, exists = pcall(function() return isfile and isfile(path) end)
		return ok and exists
	end

	-- 1) Embedded base64 songs (MJ, Chicago, etc.)
	if option.embedded or option.name == "MJ" or option.name == "Chicago" or option.name == "BAD MJ" or option.name == "XXXTENTACION BAD!" or option.name == "Gunna" or option.name == "Young" or option.name == "Travis" or option.name == "Look At Me!" or option.name == "Moonlight" or option.name == "Trippie Redd" or option.name == "The Race" then
		if not fileExists(fileName) and writefile then
			local b64data = nil
			if option.name == "MJ" or fileName == "MJ_intro.mp3" then b64data = M._MJ_INTRO_B64
			elseif option.name == "Chicago" or fileName == "Chicago_intro.mp3" then b64data = M._CHICAGO_INTRO_B64
			elseif option.name == "BAD MJ" or fileName == "BAD_MJ_intro.mp3" then b64data = M._BAD_MJ_INTRO_B64
			elseif option.name == "XXXTENTACION BAD!" or fileName == "XXX_BAD_intro.mp3" then b64data = M._XXX_BAD_INTRO_B64
			elseif option.name == "Gunna" or fileName == "Gunna_intro.mp3" then b64data = M._GUNNA_INTRO_B64
			elseif option.name == "Young" or fileName == "Young_intro.mp3" then b64data = M._YOUNG_INTRO_B64
			elseif option.name == "Travis" or fileName == "Travis_intro.mp3" then b64data = M._TRAVIS_INTRO_B64
			elseif option.name == "Look At Me!" or fileName == "Look_At_Me_intro.mp3" then b64data = M._LOOK_AT_ME_INTRO_B64
			elseif option.name == "Moonlight" or fileName == "Moonlight_intro.mp3" then b64data = M._MOONLIGHT_INTRO_B64
			elseif option.name == "Trippie Redd" or fileName == "Trippie_Redd_intro.mp3" then b64data = M._TRIPPIE_REDD_INTRO_B64
			elseif option.name == "The Race" or fileName == "The_Race_intro.mp3" then b64data = M._THE_RACE_INTRO_B64
			end
			if b64data then
				pcall(function()
					local decoded = nil
					if crypt and crypt.base64decode then
						decoded = crypt.base64decode(tostring(b64data))
					elseif base64 and base64.decode then
						decoded = base64.decode(tostring(b64data))
					end
					if decoded then writefile(fileName, decoded) end
				end)
			end
		end
		local asset = tryAsset(fileName)
		if asset then
			M.introSongCache[fileName] = asset
			return asset
		end
	end

	-- 2) Local files - try multiple common locations (important for different executors / PolSec)
	local possiblePaths = {
		fileName,
		"workspace/" .. fileName,
		"./workspace/" .. fileName,
		"scripts/" .. fileName,
		"autoexec/" .. fileName,
		"../" .. fileName,
	}

	for _, path in ipairs(possiblePaths) do
		if fileExists(path) then
			local asset = tryAsset(path)
			if asset then
				M.introSongCache[fileName] = asset
				print("[MJ HUB] ✓ Loaded local intro:", path)
				return asset
			end
		end
	end

	-- 3) URL download (for the original catbox songs)
	if option.url and option.url ~= "" then
		if writefile and getcustomasset then
			local ok, data = pcall(function() return game:HttpGet(option.url) end)
			if ok and data and #data > 1000 then
				pcall(function() writefile(fileName, data) end)
				local asset = tryAsset(fileName)
				if asset then
					M.introSongCache[fileName] = asset
					print("[MJ HUB] ✓ Downloaded & loaded:", option.name)
					return asset
				end
			end
		end
		-- some executors accept direct http SoundId
		return option.url
	end

	warn("[MJ HUB] ✗ Could not load song:", option.name)
	warn("[MJ HUB] → Put", fileName, "in your executor workspace folder!")
	return nil
end

