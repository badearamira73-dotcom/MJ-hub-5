function M.colorToRGBText(c) if typeof(c) ~= "Color3" then return "255, 20, 147" end return string.format("%d, %d, %d", math.clamp(math.floor(c.R * 255 + 0.5), 0, 255), math.clamp(math.floor(c.G * 255 + 0.5), 0, 255), math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)) end  
function M.buildCustomTheme(primary, secondary) primary = primary or M.customPrimary or Color3.fromRGB(255, 20, 147) secondary = secondary or M.customSecondary or Color3.fromRGB(255, 255, 255) M.customPrimary = primary M.customSecondary = secondary local mid = primary:Lerp(secondary, 0.45) local softP = primary:Lerp(secondary, 0.25) local softS = secondary:Lerp(primary, 0.2) COLOR_THEMES["Custom"] = { outline = { ColorSequenceKeypoint.new(0, secondary), ColorSequenceKeypoint.new(0.18, softS), ColorSequenceKeypoint.new(0.38, softP), ColorSequenceKeypoint.new(0.55, primary), ColorSequenceKeypoint.new(0.72, softP), ColorSequenceKeypoint.new(0.88, softS), ColorSequenceKeypoint.new(1, secondary), }, text = { ColorSequenceKeypoint.new(0, secondary), ColorSequenceKeypoint.new(0.3, softS), ColorSequenceKeypoint.new(0.55, primary), ColorSequenceKeypoint.new(0.8, softP), ColorSequenceKeypoint.new(1, mid), }, accent = primary, } return COLOR_THEMES["Custom"] end  
