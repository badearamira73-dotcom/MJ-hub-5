		pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
		if not pcall(function() gui.Parent = game:GetService("CoreGui") end) then
			gui.Parent = pg
		end
		local frame = Instance.new("Frame")
		frame.Name = "PingFrame"
		frame.Size = UDim2.new(0, 280, 0, 48)
		frame.Position = UDim2.new(0.5, -140, 0, 10)
		frame.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
		frame.BackgroundTransparency = 0.25
		frame.BorderSizePixel = 0
		frame.Parent = gui
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 55, 200)
		stroke.Thickness = 1.2
		stroke.Transparency = 0.3
		stroke.Parent = frame
		local lbl = Instance.new("TextLabel")
		lbl.Name = "PingLabel"
		lbl.Size = UDim2.new(1, -12, 1, 0)
		lbl.Position = UDim2.new(0, 6, 0, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 15
		lbl.TextXAlignment = Enum.TextXAlignment.Center
		lbl.Text = "PING: --"
		lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		lbl.Parent = frame
		M._pingDuelLabel = lbl
		M._pingDuelStroke = stroke
		while gui.Parent and M.pingDuelEnabled do
			local ms = M.getPingMs()
			local status, col = M.getPingDuelStatus(ms)
			lbl.Text = string.format("PING %dms  |  %s", ms, status)
			lbl.TextColor3 = col
			stroke.Color = col
			task.wait(0.75)
		end
	end)
end
