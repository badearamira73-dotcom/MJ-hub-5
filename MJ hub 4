function M.cursedInstaReset()
	-- Fast insta reset (~1 second)
	if M._instaResetting then return end
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	M._instaResetting = true
	local tpPos = M.instaResetTP or CFrame.new(2000.5, 9911.9, 4000.2)
	local cam = workspace.CurrentCamera
	local lockedCam = cam and cam.CFrame
	local t0 = tick()

	pcall(function()
		if cam and lockedCam then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = lockedCam
		end
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = tpPos
		hum.Health = 0
	end)

	pcall(function()
		RunService:BindToRenderStep("MJHubInstaCamLock", Enum.RenderPriority.Camera.Value + 1, function()
			local c = workspace.CurrentCamera
			if c and lockedCam then
				c.CameraType = Enum.CameraType.Scriptable
				c.CFrame = lockedCam
			end
			local ac = player.Character
			local ahrp = ac and ac:FindFirstChild("HumanoidRootPart")
			if ahrp then
				ahrp.AssemblyLinearVelocity = Vector3.zero
				ahrp.AssemblyAngularVelocity = Vector3.zero
				ahrp.CFrame = tpPos
			end
		end)
	end)

	task.spawn(function()
		pcall(function()
			if not M.cursedResetRemote then
				for _, desc in ipairs(game:GetDescendants()) do
					if desc:IsA("RemoteEvent") and desc.Name:sub(1, 3) == "RE/" then
						M.cursedResetRemote = desc
						break
					end
				end
			end
			if M.cursedResetRemote then
				for _ = 1, 3 do
					pcall(function() M.cursedResetRemote:FireServer(M.CURSED_RESET_GUID, player, "balloon") end)
					task.wait()
				end
			end
		end)
	end)

	local done = false
	local function finish(newChar)
		if done then return end
		done = true
		pcall(function() RunService:UnbindFromRenderStep("MJHubInstaCamLock") end)
		task.spawn(function()
			local newHum = newChar and newChar:FindFirstChildOfClass("Humanoid")
			if not newHum and newChar then
				newHum = newChar:WaitForChild("Humanoid", 1)
			end
			pcall(function()
				local c = workspace.CurrentCamera
				if c then
					if newHum then c.CameraSubject = newHum end
					c.CameraType = Enum.CameraType.Custom
				end
			end)
			M._instaResetting = false
		end)
	end

	local respawnConn
	respawnConn = player.CharacterAdded:Connect(function(newChar)
		if respawnConn then pcall(function() respawnConn:Disconnect() end) end
		-- if respawn was super fast, wait remaining time so total ~1s feel is stable
		local left = 1 - (tick() - t0)
		if left > 0.05 then task.wait(math.min(left, 0.35)) end
		finish(newChar)
	end)

	-- hard cap 1 second
	task.delay(1, function()
		if respawnConn then pcall(function() respawnConn:Disconnect() end) end
		finish(player.Character)
	end)
end

function M.hasBrainrotInHand() local char = player.Character if not char then return false end for _, item in ipairs(char:GetChildren()) do if item:IsA("Tool") then local name = item.Name:lower() if name:find("bat", 1, true) or name:find("slap", 1, true) or name:find("sword", 1, true) or name:find("gun", 1, true) or name:find("knife", 1, true) or name:find("blade", 1, true) then else if name:find("brainrot", 1, true) or name:find("skibidi", 1, true) or name:find("toilet", 1, true) or name:find("animal", 1, true) or name:find("pet", 1, true) or name:find("meme", 1, true) or name:find("steal", 1, true) or item:GetAttribute("Brainrot") or item:GetAttribute("Animal") then return true end local ok, stealing = pcall(function() return player:GetAttribute("Stealing") or char:GetAttribute("Stealing") end) if ok and stealing then return true end end end end return false end  
