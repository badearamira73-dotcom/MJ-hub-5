function M.playIntroMusic()
	if not M.introSoundEnabled then return end
	M.stopIntroMusic()
	local idx = math.clamp(tonumber(M.introSongChoice) or 1, 1, #M.INTRO_MUSIC_OPTIONS)
	local option = M.INTRO_MUSIC_OPTIONS[idx]
	if not option then
		warn("[MJ HUB] No intro song option found for index", idx)
		return
	end
	task.spawn(function()
		local soundId = M.cacheIntroSong(option)
		if not soundId or soundId == "" then
			warn("[MJ HUB] Failed to load intro song:", option.name, "- Make sure", option.file, "is in your executor workspace!")
			return
		end
		local sound = Instance.new("Sound")
		sound.Name = "EmpireDuelsIntroMusic"
		sound.Volume = 1 -- louder
		sound.Looped = false
		sound.SoundId = tostring(soundId)
		sound.Parent = SoundService
		M.introPlaybackSound = sound
		introSoundInstance = sound
		local ok, err = pcall(function() sound:Play() end)
		if ok then
			print("[MJ HUB] Playing intro:", option.name)
		else
			warn("[MJ HUB] Play failed:", err)
		end
	end)
